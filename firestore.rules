rules_version = '2';

// TopLooser - regras de seguranca Firestore
//
// Tres papeis:
//
//  ADMIN (koresma@gmail.com)
//    Cria, edita e apaga eventos. Abre e fecha inscricoes. Remove participantes.
//    Apaga registos, fotos e documentos de qualquer pessoa.
//
//  PARTICIPANTE (inscrito no evento)
//    Regista as suas pesagens, edita e apaga as suas. Poe fotos na galeria e
//    documentos. Ve tudo o que ha no evento.
//
//  ESPECTADOR (autenticado, nao inscrito)
//    Ve os numeros das pesagens - e so isso, para os graficos e a classificacao
//    funcionarem. Nao escreve nada em lado nenhum.
//
// Por isso os registos estao partidos em duas coleccoes:
//
//    registos/{id}   numeros e data      -> qualquer autenticado le
//    anexos/{id}     foto do talao,      -> so participantes e admin leem
//                    notas, leitura IA
//
// Tem o mesmo id nas duas, e a app junta-os. O Firestore nao tem regras ao nivel
// do campo: se a foto ficasse no mesmo documento dos numeros, quem lesse os
// numeros lia tambem o endereco da foto.

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function emailAdmin() {
      return 'koresma@gmail.com';
    }

    function isAdmin() {
      return autenticado()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == emailAdmin();
    }

    function eventoDoc(eventoId) {
      return get(/databases/$(database)/documents/eventos/$(eventoId)).data;
    }

    function participa(eventoId) {
      return autenticado()
        && exists(/databases/$(database)/documents/eventos/$(eventoId)/participantes/$(request.auth.uid));
    }

    function souDono(recurso) {
      return autenticado() && recurso.data.uid == request.auth.uid;
    }

    function vouSerDono() {
      return autenticado() && request.resource.data.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Perfis de utilizador
    // ---------------------------------------------------------------
    match /utilizadores/{uid} {
      allow read: if autenticado();
      allow create, update: if autenticado() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Eventos
    // ---------------------------------------------------------------
    match /eventos/{eventoId} {
      // Todos os autenticados veem os eventos, para se inscreverem ou assistirem.
      allow read: if autenticado();
      allow create, update, delete: if isAdmin();

      // -------------------------------------------------------------
      // Participantes (o id do documento e o uid do utilizador)
      // -------------------------------------------------------------
      match /participantes/{uid} {
        allow read: if autenticado();

        // Inscricao propria, enquanto o evento aceitar inscricoes.
        // Quem nao se inscrever fica espectador.
        allow create: if autenticado()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && eventoDoc(eventoId).estado != 'encerrado'
          && eventoDoc(eventoId).inscricoesAbertas == true;

        // Cada um edita a sua ficha (cor, altura, alcunha). O admin modera.
        allow update: if (autenticado() && request.auth.uid == uid) || isAdmin();
        allow delete: if (autenticado() && request.auth.uid == uid) || isAdmin();
      }

      // -------------------------------------------------------------
      // Registos: so os numeros. Leitura aberta a quem tem conta, para os
      // graficos e a classificacao funcionarem para os espectadores.
      // -------------------------------------------------------------
      match /registos/{registoId} {
        allow read: if autenticado();
        allow create: if participa(eventoId) && vouSerDono();
        allow update: if (participa(eventoId) && souDono(resource) && vouSerDono()) || isAdmin();
        allow delete: if (participa(eventoId) && souDono(resource)) || isAdmin();
      }

      // -------------------------------------------------------------
      // Anexos do registo: foto do talao, notas e leitura da IA.
      // Mesmo id do registo. So para quem esta no evento.
      // -------------------------------------------------------------
      match /anexos/{registoId} {
        allow read: if participa(eventoId) || isAdmin();
        allow create: if participa(eventoId) && vouSerDono();
        allow update: if (participa(eventoId) && souDono(resource) && vouSerDono()) || isAdmin();
        allow delete: if (participa(eventoId) && souDono(resource)) || isAdmin();
      }

      // -------------------------------------------------------------
      // Galeria de fotos do evento
      // -------------------------------------------------------------
      match /galeria/{fotoId} {
        allow read: if participa(eventoId) || isAdmin();
        allow create: if participa(eventoId) && vouSerDono();
        allow update: if (participa(eventoId) && souDono(resource) && vouSerDono()) || isAdmin();
        allow delete: if (participa(eventoId) && souDono(resource)) || isAdmin();
      }

      // -------------------------------------------------------------
      // Documentos do evento (contrato assinado, regulamento, etc.)
      // -------------------------------------------------------------
      match /documentos/{docId} {
        allow read: if participa(eventoId) || isAdmin();
        allow create: if participa(eventoId) && vouSerDono();
        allow update: if (participa(eventoId) && souDono(resource) && vouSerDono()) || isAdmin();
        allow delete: if (participa(eventoId) && souDono(resource)) || isAdmin();
      }
    }

    // Necessario para a query de grupo de colecoes que descobre
    // em que eventos o utilizador ja esta inscrito.
    match /{caminho=**}/participantes/{uid} {
      allow read: if autenticado();
    }

    // Tudo o resto fica fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
