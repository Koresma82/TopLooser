# Copia este ficheiro para .env.dev, .env.test e .env.prod e preenche cada um
# com as credenciais do projeto Firebase correspondente:
#
#   ramo dev   -> modo dev   -> .env.dev   -> toplooser-test  (partilhado)
#   ramo test  -> modo test  -> .env.test  -> toplooser-test
#   ramo main  -> modo prod  -> .env.prod  -> toplooser-prod
#
# Tres ambientes de codigo, dois projetos Firebase: o dev e o test partilham a
# mesma base de dados. Os valores do .env.dev e do .env.test sao iguais.
#
# No Netlify, define estas mesmas variaveis em Site configuration >
# Environment variables, com um valor diferente por contexto.

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=

# Email com permissoes de administrador (cria e gere eventos)
VITE_ADMIN_EMAIL=koresma@gmail.com

# A etiqueta do ambiente (dev / test / prod) vem do modo com que se constroi.
# Nao ha VITE_AMBIENTE para definir.

# ---------------------------------------------------------------------------
# Leitura automatica do talao (funcao Netlify)
#
# ATENCAO: estas NAO levam o prefixo VITE_, de proposito. Tudo o que comeca por
# VITE_ e embutido no codigo que vai para o browser; a chave da API tem de ficar
# so no servidor. Define-as em Site settings > Environment variables no Netlify,
# e num ficheiro .env na raiz para o "netlify dev" local.
#
# Basta UMA das duas. Se definires as duas, a da Anthropic e a usada.
# ---------------------------------------------------------------------------

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-haiku-4-5-20251001

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.0-flash

# Opcional: 'anthropic' ou 'gemini', para forcar um deles.
FORNECEDOR_TALAO=
