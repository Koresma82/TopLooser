{
  "name": "toplooser",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TopLooser - estatisticas de desafios de perda de peso entre amigos",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:funcoes": "netlify dev",
    "dev:test": "vite --mode test",
    "build": "vite build --mode prod",
    "build:dev": "vite build --mode dev",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "regras:test": "firebase deploy --only firestore:rules,firestore:indexes,storage --project test",
    "regras:prod": "firebase deploy --only firestore:rules,firestore:indexes,storage --project prod",
    "regras:todos": "npm run regras:test && npm run regras:prod"
  },
  "dependencies": {
    "firebase": "^10.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.11"
  }
}
